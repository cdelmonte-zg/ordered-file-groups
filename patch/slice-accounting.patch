+/// Measuring instrument, not a proposal: the bytes a batch holds for its own
+/// rows. A slice is charged for the rows it carries, and a view column for its
+/// views and the bytes its rows reference, instead of the full capacity of
+/// every buffer it shares with the other slices of the same batch.
+fn own_bytes(batch: &RecordBatch) -> usize {
+    use arrow::array::{Array, AsArray};
+    batch
+        .columns()
+        .iter()
+        .map(|column| match column.data_type() {
+            DataType::Utf8View => {
+                let views = column.as_string_view();
+                views.len() * 16 + views.total_buffer_bytes_used()
+            }
+            DataType::BinaryView => {
+                let views = column.as_binary_view();
+                views.len() * 16 + views.total_buffer_bytes_used()
+            }
+            _ => column
+                .to_data()
+                .get_slice_memory_size()
+                .unwrap_or_else(|_| column.get_array_memory_size()),
+        })
+        .sum()
+}
